# Everything here is optional: `npm start` works with no .env at all.

# Claude auth. The host spawns the bundled `claude` CLI and lets it load its own
# settings, so by default it uses whatever the Claude Code CLI uses on this
# computer: a plain `claude login` (your subscription) or ~/.claude/settings.json
# (ANTHROPIC_BASE_URL + apiKeyHelper). Set the pair below only if you want the
# host to stand alone.
# ANTHROPIC_API_KEY is ignored (so runs use your Claude login, not API credit)
# unless BRIDGE_USE_API_KEY=1 is also set.
# ANTHROPIC_BASE_URL=https://your-router.example.com
# ANTHROPIC_AUTH_TOKEN=
# BRIDGE_USE_API_KEY=1
# ANTHROPIC_API_KEY=

# Where documents and projects live; the agent works in here. Default: ~/Inkside
# WORKSPACE_ROOT=

# Listen address (0.0.0.0 so the tablet can reach it on the network)
# HOST=0.0.0.0
# PORT=8787

# Name the app shows for this computer (default: the computer's name)
# INKSIDE_HOST_NAME=
# The host's id and name (default: ~/.config/inkside-host)
# INKSIDE_STATE_DIR=
# 1 = accept devices from any network, not just this computer's, without a token.
# Only on networks you fully trust.
# INKSIDE_OPEN=0

# Optional model override (unset = whichever model the CLI is configured with)
# CLAUDE_MODEL=
# 1: devices cannot change the model or provider (default on a shared host; 0 allows it).
# INKSIDE_FIXED_MODEL=

# Access token every request must carry (the app has a field for it). Setting one makes
# this a shared host: the agent and scripts run in the OS sandbox and see only the
# workspace. See host/README.md, "Sharing a computer". Use a long random string:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# BRIDGE_TOKEN=
# 0: a token, but not shared (only if the token is yours alone). 1: shared without one.
# INKSIDE_SHARED=
# Shared host: hosts the sandboxed agent and scripts may reach (empty: none).
# INKSIDE_SANDBOX_DOMAINS=pypi.org,files.pythonhosted.org
# Shared host: 1 turns dictation on (ffmpeg decodes guests' audio outside the sandbox).
# INKSIDE_DICTATION=
# Shared host: agent replies running at once.
# INKSIDE_MAX_RUNS=3
# 1: requests from this computer skip the token. Leave off behind a local reverse proxy.
# BRIDGE_TRUST_LOOPBACK=
# Extra host names devices may address this computer by (comma-separated).
# INKSIDE_ALLOWED_HOSTS=
# Where uploaded app crash reports go (default host/logs)
# BRIDGE_LOG_DIR=

# Developer setup: 1 enables the /improve endpoints (an agent that edits this repository).
# INKSIDE_IMPROVE=
# Developer setup: install APKs rebuilt by the Improve chat on this device.
# ADB_SERIAL=
